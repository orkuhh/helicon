{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Helicon",
  "version": "0.17.0",
  "identifier": "app.helicon.desktop",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run fetch:node --workspace helicon-desktop && npm run dev --workspace @helicon/web",
    "beforeBuildCommand": "npm run build --workspace @helicon/web && npm run bundle:server --workspace helicon-desktop && npm run fetch:node --workspace helicon-desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Helicon",
        "width": 1280,
        "height": 820,
        "minWidth": 880,
        "minHeight": 560,
        "dragDropEnabled": false,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self' http://127.0.0.1:*; connect-src http://127.0.0.1:*; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png"],
    "resources": ["resources/server.cjs", "resources/frontend"],
    "externalBin": ["binaries/node"],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZBOEFGNzkyMDBBNkZERkEKUldUNi9hWUFrdmVLYXV1aFFUeXpWWVJ3UXhZY3psT0hGSUxieUVrUkwxSmh0Wjg3WHJ0NkM1U0UK",
      "endpoints": [
        "https://helicon.sh/api/update/{{target}}/{{current_version}}",
        "https://github.com/HarjjotSinghh/helicon/releases/latest/download/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  }
}
